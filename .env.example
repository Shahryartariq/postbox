# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These are public by design; the security rules in firestore.rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Full URL of the deployed site, used for link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development without a Firebase project: run `pnpm emulators` and set this to true.
NEXT_PUBLIC_FIREBASE_EMULATOR=false
